@INPROCEEDINGS{796997,
author={S. Radhakrishnan and G. Racherla and C. N. Sekharan and N. S. V. Rao and S. G. Batsell},
booktitle={WCNC. 1999 IEEE Wireless Communications and Networking Conference (Cat. No.99TH8466)},
title={DST-A routing protocol for ad hoc networks using distributed spanning trees},
year={1999},
volume={},
number={},
pages={1543-1547 vol.3},
abstract={A dynamic ad hoc network consists of a collection of mobile hosts with frequently changing network topology. We propose a distributed algorithm that adapts to the topology by utilizing spanning trees in the regions where the topology is stable, and resorting to an intelligent flooding-like approach in highly dynamic regions of the network. Routing is performed using the spanning trees based on a hold-and-forward or shuttling method. We introduce the notion of connectivity-through-time and holding time to quantify the performance of the routing algorithms for various network connectivity scenarios. Using simulation, we study the throughput, reachability and message-reachability ratio of the proposed network under various connection/reconnection rates and holding times},
keywords={distributed algorithms;mobile computing;network topology;protocols;telecommunication network routing;trees (mathematics);DST;ad hoc networks;connection/reconnection rates;connectivity-through-time;distributed algorithm;distributed spanning trees;frequently changing network topology;highly dynamic regions;holding time;intelligent flooding-like approach;message-reachability ratio;mobile computers;mobile hosts;network connectivity scenarios;performance;reachability;routing protocol;shuttling method;simulation;Ad hoc networks;Computer networks;Distributed algorithms;Mobile computing;Mobile robots;Network topology;Routing protocols;Spine;Taxonomy;Throughput},
doi={10.1109/WCNC.1999.796997},
ISSN={1525-3511},
month={},}

