###### EXPERIMENT SET UP ######
# [minutes]
SIMULATION_TIME=1
# [meters]
COMM_AREA_LENGTH=90
# [int]
DENSITY_REGIONS_NO=2
# [boolean]
WITH_MOBILITY=false

### NODES SET UP ###
# [seconds]
NODES_MOV_FREQ=10
# [int]
NODES_NO_PER_REGION=600
# [meters]
NODES_TRANSMISSION_RANGE=6
### NODES SET UP [END] ###

### MESSAGES SET UP ###
# [int]
BROADCAST_MSGS_NO=100
# [int]
CONTROL_MSGS_NO=5
### MESSAGES SET UP [END] ###

### ALGORITHMS SET UP ###
# current implementations of broadcast algorithms:
#   - pure flooding (ID: pure-flooding)
#   - time-based flooding (ID: time-based-flooding)
#   - MPR (ID: mpr)
#   - CDS-based technique (ID: cds)
#   - ABBA (ID: abba)
# [string]
ALGO_AT_DENSE_AREA=cds
# [string]
ALGO_AT_SPARSE_AREA=simplef
### ALGORITHMS SET UP [END] ###

### ADAPTATION SET UP ###
# [optional, string]
WITH_ADAPTATION=false
# In case WITH_ADAPTATION is set to 0, the following variables are ignored
# Integer value that defines adaptation policy as follows:
# - 0: LOCAL
# - 1: SWSP
# - 2: DENSITY_AREA
ADAPTATION_POLICY=0
### ADAPTATION SET UP [END] ###
