###### EXPERIMENT SET UP ######

# [minutes]
SIMULATION_TIME=1
# [meters]
COMM_AREA_LENGTH=150
# [int]
DENSITY_REGIONS_NO=2

### NODES SET UP ###
# [seconds]
NODES_MOV_FREQ=10
# [int]
NODES_NO_PER_REGION=200
# [meters]
NODES_TRANSMISSION_RANGE=20
### NODES SET UP [END] ###

### MESSAGES SET UP ###
# [int]
BROADCAST_MSGS_NO=10
# [int]
CONTROL_MSGS_NO=20
### MESSAGES SET UP [END] ###

### ALGORITHMS SET UP ###
# current implementations of broadcast algorithms:
#   - pure flooding (ID: pure_flooding)
#   - time-based flooding (ID: time-based_flooding)
#   - MPR (ID: mpr)
#   - CDS-based technique (ID: cds)
#   - ABBA (ID: abba)
# [string]
ALGO_AT_DENSE_AREA=mpr
# [string]
ALGO_AT_SPARSE_AREA=pure-flooding
### ALGORITHMS SET UP [END] ###

### ADAPTATION SET UP ###
# [optional, string]
WITH_ADAPTATION=true
# In case WITH_ADAPTATION is set to 0, the following variables are ignored
# Integer value that defines adaptation policy as follows:
# - 0: LOCAL
# - 1: SWSP
# - 2: DENSITY_AREA
ADAPTATION_POLICY=0
### ADAPTATION SET UP [END] ###
