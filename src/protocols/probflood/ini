description = "Broadcasting messages using Probabilistic Flooding"
*.host*.udpApp[0].typename = "ProbFlooding"
*.host*.udpApp[0].nr_hello_messages = true
*.host*.udpApp[0].helloTime = 1s
# Particular options
*.host*.udpApp[0].scheme = "DENSITY_BORDER_AWARE"
*.host*.udpApp[0].k = 4
#*.host*.udpApp[0].sigma = 1.0
*.host*.udpApp[0].probLi = 0.5
