{% for n in nodes -%}
{% if n.algorithm() == "mprt2" %}
*.{{n.name}}.udpApp[0].typename = "Mpr_t2"
*.{{n.name}}.udpApp[0].protocolId = "Mpr_t2"
*.{{n.name}}.udpApp[0].nr_hello_messages = 906
*.{{n.name}}.udpApp[0].helloTime = 0.5s
{% else %} {% if n.algorithm() == "flooding" %}
*.{{n.name}}.udpApp[0].typename = "Flooding2"
*.{{n.name}}.udpApp[0].protocolId = "Flooding2"
*.{{n.name}}.udpApp[0].timeOut = 0.02
*.{{n.name}}.udpApp[0].nr_hello_messages = 0
{% endif -%} {% endif %}
{% endfor -%}

*.hostR*.udpApp[0].withAdaptation = true
