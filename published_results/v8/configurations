[General]
**.arpType = "GlobalARP"
*.host*.mobilityType = "LinearMobility"
# this lovely and unknown line is the one enabling broadcast in IPv4. We need this feature in order to simulate sending simultaneasly to many nodes in wireless networks
*.host*.networkLayer.ip.forceBroadcast = true

# Set up a model for the energy consumption of the nodes
**.energyConsumerType = "StateBasedEnergyConsumer"
**.energyConsumer.offPowerConsumption = 0mW
**.energyConsumer.receiverReceivingPowerConsumption = 10mW
**.energyConsumer.receiverIdlePowerConsumption = 0mW
**.energyConsumer.receiverBusyPowerConsumption = 0mW
**.energyConsumer.receiverSynchronizingPowerConsumption = 0mW
**.energyConsumer.sleepPowerConsumption = 0mW
**.energyConsumer.switchingPowerConsumption = 0mW
**.energyConsumer.transmitterIdlePowerConsumption = 0mW
**.energyConsumer.transmitterTransmittingPowerConsumption = 150mW #75mW

*.host*.energyStorageType = "SimpleEnergyStorage"
*.host*.energyStorage.nominalCapacity = 10J

*.host*.wlan[*].typename = "IdealWirelessNic"
*.host*.wlan[*].radioType = "EnergyAwareIdealRadio"

**.bitrate = 1Mbps

*.host*.wlan[*].radio.receiver.ignoreInterference = false

*.host*.numUdpApps = 1
*.host*.udpApp[0].remotePort = 10000
*.host*.udpApp[0].localPort = 10000

# who is the source
*.host*.udpApp[0].intervalBroadcastTime = 0.5s


*.host*.wlan[*].radio.transmitter.maxCommunicationRange = 120m

# simulation time
sim-time-limit =  180s



description = "Broadcasting messages using ABBA"

repeat=4

*.host*.udpApp[0].typename = "Abba2"
*.SOURCE.udpApp[0].is_source = true
*.SOURCE.udpApp[0].nr_broadcast_msg = 300
*.SOURCE.udpApp[0].wakeUpTime = 20s

*.host*.energyStorage.nominalCapacity = 50J

# simulation time
sim-time-limit =  180s



description = "Broadcasting messages using Dist2Mean"

repeat=4

*.host*.udpApp[0].typename = "Dist2Mean2"
*.SOURCE.udpApp[0].is_source = true
*.SOURCE.udpApp[0].nr_broadcast_msg = 300
*.SOURCE.udpApp[0].wakeUpTime = 20s

*.host*.energyStorage.nominalCapacity = 50J

*.host*.udpApp[0].nr_hello_messages = 5
*.host*.udpApp[0].maximumDelay = 0.6s

# simulation time
sim-time-limit =  180s



description = "Broadcasting messages using EWMA2"

repeat=4

*.host*.udpApp[0].typename = "EWMA2"
*.SOURCE.udpApp[0].is_source = true
*.SOURCE.udpApp[0].nr_broadcast_msg = 300
*.SOURCE.udpApp[0].wakeUpTime = 20s

*.host*.energyStorage.nominalCapacity = 50J

*.host*.udpApp[0].nr_hello_messages = 5
*.host*.udpApp[0].maximumDelay = 0.6s

# mwst related stuff
*.host*.udpApp[0].spontaneously_awaken = true
*.host*.udpApp[0].mwst_display_time = 170s

# simulation time
sim-time-limit =  180s




description = "Broadcasting messages using CDS"

repeat=4

*.host*.udpApp[0].typename = "CDS2"
*.SOURCE.udpApp[0].is_source = true
*.SOURCE.udpApp[0].nr_broadcast_msg = 300
*.SOURCE.udpApp[0].wakeUpTime = 25s

*.host*.energyStorage.nominalCapacity = 50J

*.host*.udpApp[0].nr_hello_messages = 3
*.host*.udpApp[0].maximumDelay = 0.2s
*.host*.udpApp[0].helloTime = uniform(0.1s, 0.3s)

# mpr related stuff
*.host*.udpApp[0].build_hops = true

*.host*.udpApp[0].wakeup_time_to_build_hops = 8s

*.host*.udpApp[0].display_time_hops = 20s

# simulation time
sim-time-limit =  180s





